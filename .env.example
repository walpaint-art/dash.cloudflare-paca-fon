# =========================================================
#  Configuração do Videochamada Web
#  Copie este arquivo para ".env" e preencha.
#  NÃO compartilhe o arquivo .env
# =========================================================

# Porta do servidor
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------
# TOKEN DE ACESSO
# Se preenchido, só quem tiver o link com ?token=XXX entra.
# Gere um forte com:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------
ACCESS_TOKEN=

# ---------------------------------------------------------
# DOMÍNIOS PERMITIDOS (separados por vírgula)
# Exemplo: https://chamada.com.br,https://www.chamada.com.br
# Vazio = aceita qualquer origem
# ---------------------------------------------------------
ALLOWED_ORIGINS=

# ---------------------------------------------------------
# SERVIDOR TURN (necessário para conectar em redes restritivas)
# Use o coturn: https://github.com/coturn/coturn
# Vários endereços separados por vírgula (udp e tcp)
# ---------------------------------------------------------
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------------------------------------------------------
# Limite de participantes simultâneos (sala única)
# ---------------------------------------------------------
MAX_PARTICIPANTS=10
