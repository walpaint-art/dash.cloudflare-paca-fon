# =========================================================
#  Caddy - proxy reverso com HTTPS automático (certificado grátis)
#  Uso:
#    1. instale o Caddy no servidor
#    2. copie este arquivo para /etc/caddy/Caddyfile
#    3. troque SEU-DOMINIO.com.br pelo seu domínio
#    4. caddy reload
# =========================================================

SEU-DOMINIO.com.br {
    encode zstd gzip

    # WebSocket do Socket.IO (suporte automático)
    reverse_proxy 127.0.0.1:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Log de acessos
    log {
        output file /var/log/caddy/chamada.log
        format json
    }
}
